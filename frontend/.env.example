# The SPA and analyzer API use the same app registration.
VITE_MSAL_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_MSAL_AUTHORITY=https://login.microsoftonline.com/organizations
# Optional. Defaults to the current origin, which must be registered in Entra ID.
# Use http://localhost:5173 for Vite development or http://localhost:8080 for Compose.
# VITE_MSAL_REDIRECT_URI=http://localhost:5173

# Optional shared ProcurementSuite deployment JSON and tenant stylesheet URLs.
# Both files are fetched by the browser and must allow requests from the analyzer origin.
# VITE_DEPLOYMENT_CONFIGURATION=https://raw.githubusercontent.com/example/config/main/config.json
# VITE_DEPLOYMENT_CSS=https://cdn.example.com/deployment.css
