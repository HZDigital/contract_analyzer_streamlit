# FastAPI runtime
PORT=8080

# Azure Blob job storage. Keep this secret out of source control.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-storage-account;AccountKey=your-account-key;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=contract-analyzer

# Entra ID token validation in the API. This is the bare API application client ID
# from the v2 access-token aud claim, not its api:// Application ID URI.
ENTRA_API_AUDIENCE=00000000-0000-0000-0000-000000000000
# Optional comma-separated allow-list when a deployment intentionally limits tenants.
# ENTRA_ALLOWED_TENANT_IDS=tenant-id-1,tenant-id-2

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=put-your-key-here
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure Foundry Mistral Document AI OCR. When omitted, scanned PDFs use Tesseract.
# AZURE_MISTRAL_DOCUMENT_AI_ENDPOINT=https://your-serverless-endpoint
# AZURE_MISTRAL_DOCUMENT_AI_API_KEY=put-your-key-here
# AZURE_MISTRAL_DOCUMENT_AI_MODEL=mistral-document-ai-2512
# AZURE_MISTRAL_DOCUMENT_AI_TIMEOUT_SECONDS=90

# Optional market-research integration
SEARXNG_URL=https://your-searxng.example.com
